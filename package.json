{
	"name": "oh-your-pi",
	"version": "0.0.2",
	"description": "Electrobun desktop client powered by React and Vite",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "concurrently --kill-others-on-fail \"bun run dev:web\" \"bun run dev:main\"",
		"dev:main": "electrobun dev --watch",
		"dev:web": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"build:stable": "vite build && electrobun build --env=stable",
		"build": "vite build && electrobun build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"verify": "bun run typecheck && bun run test && bun run build"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@fontsource-variable/geist": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "^1.18.1",
		"immer": "^11.1.15",
		"lucide-react": "^1.25.0",
		"radix-ui": "^1.6.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.185.1",
		"@vitejs/plugin-react": "^6.0.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^10.0.3",
		"postcss": "^8.4.49",
		"sass": "^1.101.6",
		"shadcn": "^4.14.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5"
	}
}
